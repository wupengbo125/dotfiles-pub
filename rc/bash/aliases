#!/bin/bash
# Alias definitions

# Network
alias goo='curl -s -o /dev/null -w "HTTP %{http_code}\n" --connect-timeout 5 -x http://127.0.0.1:7890 https://www.google.com'


# Shell
alias sh=bash

